{
  "name": "quad-image",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "test:component": "cypress run --component",
    "lint": "eslint             'web/**/*.ts*' 'tests/web/**/*.ts*'",
    "lint-fix": "eslint --fix   'web/**/*.ts*' 'tests/web/**/*.ts*'",
    "format": "prettier --write 'web/**/*.ts*' 'tests/web/**/*.ts*'",
    "watch": "vite build --watch --mode development",
    "bundle-size": "ANALYZE=true vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@preact/preset-vite": "^2",
    "@testing-library/preact": "^3",
    "@tsconfig/recommended": "^1",
    "@types/node": "^24",
    "@types/number-to-words": "^1",
    "@vitest/eslint-plugin": "^1",
    "cypress": "^15",
    "eslint": "^10",
    "jiti": "^2",
    "jsdom": "^30",
    "jsonapi-typescript": "0.1.3",
    "mdi-preact": "^9",
    "prettier": "~3.9",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-bundle-analyzer": "^1",
    "vitest": "^4"
  },
  "dependencies": {
    "ensure-error": "^5",
    "history": "^5",
    "number-to-words": "^1",
    "preact": "^10.17",
    "preact-fetching": "^1",
    "preact-router": "^4.1",
    "serialize-error": "^13",
    "zod": "^4"
  }
